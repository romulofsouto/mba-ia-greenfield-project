    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {}
      },
      "VideoResponse": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "title": {
            "type": "string",
            "example": "aula"
          },
          "original_filename": {
            "type": "string",
            "example": "aula.mp4"
          },
          "mime_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "example": 104857600
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ]
          },
          "editorial_status": {
            "type": "string",
            "enum": [
              "draft"
            ]
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 12.5
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "video_codec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audio_codec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "format_name": {
            "type": "string",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "description": "Short-lived presigned URL of the thumbnail, when generated"
          },
          "failure_reason": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "public_id",
          "title",
          "original_filename",
          "mime_type",
          "size_bytes",
          "processing_status",
          "editorial_status",
          "duration_seconds",
          "width",
          "height",
          "video_codec",
          "audio_codec",
          "format_name",
          "thumbnail_url",
          "failure_reason",
          "created_at",
          "updated_at"
        ]
      },
      "UploadPlanResponse": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "part_size",
          "part_count"
        ]
      },
      "CreateVideoResponse": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoResponse"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadPlanResponse"
          }
        },
        "required": [
          "video",
          "upload"
        ]
      },
      "DeliveryUrlResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Short-lived presigned URL served directly by the storage"
          },
          "expires_in": {
            "type": "number",
            "example": 900
          }
        },
        "required": [
          "url",
          "expires_in"
        ]
      },
      "PartUrlsDto": {
        "type": "object",
        "properties": {}
      },
      "PartUrlResponse": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "PartUrlsResponse": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlResponse"
            }
          },
          "expires_in": {
            "type": "number",
            "example": 3600
          }
        },
        "required": [
          "parts",
          "expires_in"
        ]
      },
      "UploadedPartResponse": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "example": "\"9b2cf535f27731c974343645a3985328\""
          },
          "size_bytes": {
            "type": "number",
            "example": 67108864
          }
        },
        "required": [
          "part_number",
          "etag",
          "size_bytes"
        ]
      },
      "UploadedPartsResponse": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartResponse"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}